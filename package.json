{
  "name": "Sesha",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:prod": "npm run build:prod && npx cap sync",
    "android:build": "npm run build && npx cap sync && npx cap open android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "android:apk:prod": "npm run build:prod && npx cap sync android && cd android && gradlew assembleRelease",
    "android:run": "npm run build && npx cap run android",
    "ios:build": "npm run build && npx cap sync && npx cap open ios",
    "ios:run": "npm run build && npx cap run ios",
    "mobile:dev": "npm run build && npx cap sync"
  },
  "private": true,
