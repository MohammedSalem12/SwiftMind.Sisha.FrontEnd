// ── Design tokens ───────────────────────────────
$purple:      var(--ngx-primary);
$purple-dark: var(--ngx-hero-end);
$blue:        #3b82f6;
$green:       #10b981;
$orange:      #f59e0b;
$red:         #ef4444;
$pink:        #ec4899;
$bg:          #f0f2f5;
$card-shadow: 0 2px 12px rgba(0,0,0,0.07);
$card-radius: 14px;

// ── Root container ───────────────────────────────
.parent-dashboard {
  min-height: 100vh;
  background: $bg;
  direction: rtl;
}

// ── Hero ─────────────────────────────────────────
.hero-header {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, $purple 0%, $purple-dark 100%);
  padding: 2rem 1.5rem 2.5rem;
  color: white;

  .hero-shapes {
    position: absolute; inset: 0; pointer-events: none;
    .shape {
      position: absolute;
      border-radius: 50%;
      opacity: 0.12;
      background: white;
    }
    .shape-1 { width: 220px; height: 220px; top: -60px; left: -60px; }
    .shape-2 { width: 140px; height: 140px; bottom: -40px; right: 10%; }
    .shape-3 { width: 80px;  height: 80px;  top: 50%;    right: 30%; }
  }

  .hero-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero-text h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    margin: 0 0 0.25rem;
  }
  .hero-text p { margin: 0; opacity: 0.85; font-size: 0.95rem; }

  .hero-avatar {
    width: 64px; height: 64px; flex-shrink: 0;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.75rem;
  }
}

// ── Dashboard body ────────────────────────────────
.dashboard-body {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

// ── Stat cards ────────────────────────────────────
.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0.875rem;

  @media (max-width: 900px) { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 560px) { grid-template-columns: repeat(2, 1fr); }
}

.stat-card {
  position: relative;
  background: white;
  border-radius: $card-radius;
  box-shadow: $card-shadow;
  padding: 1.1rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.875rem;
  cursor: pointer;
  transition: transform 0.18s, box-shadow 0.18s;
  overflow: hidden;

  &::before {
    content: '';
    position: absolute; top: 0; right: 0;
    width: 3px; height: 100%;
    background: currentColor;
    opacity: 0;
    transition: opacity 0.18s;
  }

  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    &::before { opacity: 1; }
  }

  .stat-icon {
    width: 44px; height: 44px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    i { font-size: 1.1rem; }
  }

  .stat-info {
    flex: 1;
    .stat-num { 
      font-size: 1.4rem; 
      font-weight: 700; 
      color: #1a202c; 
      line-height: 1.2;
    }
    .stat-label { 
      font-size: 0.75rem; 
      color: #718096; 
      font-weight: 500;
    }
  }

  &.stat-purple .stat-icon { background: linear-gradient(135deg, $purple 0%, $purple-dark 100%); color: white; }
  &.stat-blue .stat-icon { background: linear-gradient(135deg, $blue 0%, #1d4ed8 100%); color: white; }
  &.stat-green .stat-icon { background: linear-gradient(135deg, $green 0%, #059669 100%); color: white; }
  &.stat-orange .stat-icon { background: linear-gradient(135deg, $orange 0%, #d97706 100%); color: white; }
  &.stat-pink .stat-icon { background: linear-gradient(135deg, $pink 0%, #be185d 100%); color: white; }
  
  &.stat-alert {
    border: 1px solid #fbbf24;
    background: #fef3c7;
    .stat-icon { background: linear-gradient(135deg, $orange 0%, #d97706 100%); }
  }
}

// ── Loading States ─────────────────────────────────
.loading-text {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 2rem;
  color: #718096;
  font-size: 0.95rem;
}

.spinner-inline {
  width: 20px; height: 20px;
  border: 2px solid #e2e8f0;
  border-top-color: $purple;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: loading 1.5s infinite;
  border-radius: $card-radius;
  height: 80px;
}

@keyframes loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

// ── Error & Empty States ──────────────────────────────
.error-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  text-align: center;
  background: white;
  border-radius: $card-radius;
  box-shadow: $card-shadow;
  margin: 2rem 1rem;
}

.error-content, .empty-content {
  max-width: 400px;
  text-align: center;

  .error-icon, .empty-icon {
    width: 64px; height: 64px;
    background: #fee2e2;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.5rem;
    
    i { font-size: 2rem; color: #dc2626; }
  }
  
  .empty-icon {
    background: #f0f9ff;
    i { color: $blue; }
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #374151;
    margin: 0 0 0.75rem;
  }

  p {
    font-size: 0.95rem;
    color: #6b7280;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }
}

.btn-retry, .btn-primary {
  background: linear-gradient(135deg, $purple 0%, $purple-dark 100%);
  color: white; border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 10px; font-size: 0.9rem; font-weight: 600;
  cursor: pointer; transition: all 0.3s ease;
  display: flex; align-items: center; gap: 0.5rem;

  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
  }
}

// ── Quick Actions Section ─────────────────────────────
.quick-actions-section {
  background: white;
  border-radius: $card-radius;
  padding: 1.5rem;
  box-shadow: $card-shadow;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid #f0f0f0;

  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a202c;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-count {
    background: #f1f5f9;
    color: #64748b;
    padding: 0.375rem 0.875rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
  }
}

.quick-actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 0.875rem;
}

.qa-btn {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 1rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.9rem;
  font-weight: 500;
  color: #374151;

  &:hover {
    background: #f8fafc;
    border-color: $purple;
    color: $purple;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  i { font-size: 1.1rem; }
}

// ── Children Section ───────────────────────────────
.children-section {
  background: white;
  border-radius: $card-radius;
  padding: 1.5rem;
  box-shadow: $card-shadow;
}

.children-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 1.25rem;
}

.child-card {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 1.5rem;
  transition: all 0.3s ease;

  &:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    border-color: $purple;
  }
}

.child-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.child-avatar {
  width: 56px; height: 56px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, $purple 0%, $purple-dark 100%);
  color: white;
  font-size: 1.3rem;
  font-weight: 600;
}

.child-meta {
  flex: 1;

  .child-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a202c;
    margin: 0 0 0.5rem;
  }

  .child-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
}

.badge-code, .badge-grade, .badge-relation {
  font-size: 0.75rem;
  padding: 0.25rem 0.625rem;
  border-radius: 6px;
  font-weight: 600;
}

.badge-code {
  background: #e0e7ff;
  color: #3730a3;
}

.badge-grade {
  background: #dcfce7;
  color: #166534;
}

.badge-relation {
  background: #fef3c7;
  color: #d97706;
}

.child-menu {
  .menu-btn {
    background: none;
    border: none;
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: #6b7280;
    transition: all 0.2s ease;

    &:hover {
      background: #f3f4f6;
      color: $purple;
    }
  }
}

// ── Performance Grid ─────────────────────────────
.performance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.875rem;
  margin-bottom: 1.25rem;
}

.metric-card {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 1rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.metric-icon {
  width: 40px; height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;

  &.attendance { background: #dcfce7; color: #166534; }
  &.grades { background: #fef3c7; color: #d97706; }
  &.no-grades { background: #f3f4f6; color: #6b7280; }

  i { font-size: 1rem; }
}

.metric-info {
  flex: 1;
  display: flex;
  flex-direction: column;

  .metric-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 0.25rem;

    &.val-good { color: #166534; }
    &.val-mid { color: #d97706; }
    &.val-bad { color: #dc2626; }
    &.grade-val { color: $purple; }
  }

  .metric-label {
    font-size: 0.75rem;
    color: #6b7280;
    font-weight: 500;
  }
}

// ── Attendance Section ─────────────────────────────
.attendance-section {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 1rem;
  margin-bottom: 1rem;
}

.attendance-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
  font-size: 0.85rem;
  color: #6b7280;
}

.attendance-percentage {
  font-weight: 700;
  font-size: 0.9rem;

  &.val-good { color: #166534; }
  &.val-mid { color: #d97706; }
  &.val-bad { color: #dc2626; }
}

.progress-bar-wrap {
  height: 8px;
  background: #e5e7eb;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 0.75rem;
}

.progress-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 0.4s ease;

  &.fill-good { background: #166534; }
  &.fill-mid { background: #d97706; }
  &.fill-bad { background: #dc2626; }
}

.absence-detail {
  .absence-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .course-absence {
    font-size: 0.75rem;
    background: #fee2e2;
    color: #dc2626;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .more-absences {
    font-size: 0.75rem;
    color: #6b7280;
    font-style: italic;
  }
}

// ── Action Buttons ─────────────────────────────
.action-buttons {
  display: flex;
  gap: 0.75rem;
}

.btn-primary, .btn-secondary {
  flex: 1;
  padding: 0.75rem 1rem;
  border-radius: 8px;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-primary {
  background: linear-gradient(135deg, $purple 0%, $purple-dark 100%);
  color: white;
  border: none;

  &:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
  }
}

.btn-secondary {
  background: white;
  color: $purple;
  border: 1px solid $purple;

  &:hover {
    background: $purple;
    color: white;
    transform: translateY(-1px);
  }
}

// ── Responsive Design ─────────────────────────────
@media (max-width: 768px) {
  .hero-header {
    padding: 1.5rem 1rem;
    .hero-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    .hero-avatar {
      width: 48px; height: 48px; font-size: 1.5rem;
    }
  }

  .dashboard-body {
    padding: 1rem 0.75rem 2rem;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .quick-actions-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .children-grid {
    grid-template-columns: 1fr;
  }

  .performance-grid {
    grid-template-columns: 1fr;
  }

  .action-buttons {
    flex-direction: column;
  }
}

@media (max-width: 480px) {
  .hero-header {
    padding: 1.25rem 0.75rem;
    .hero-text h1 { font-size: 1.5rem; }
    .hero-avatar {
      width: 40px; height: 40px; font-size: 1.25rem;
    }
  }

  .dashboard-body {
    padding: 0.75rem 0.5rem 1.5rem;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .quick-actions-grid {
    grid-template-columns: 1fr;
  }

  .child-card {
    padding: 1rem;
  }

  .child-header {
    flex-direction: column;
    text-align: center;
    gap: 0.75rem;
  }

  .performance-grid {
    gap: 0.75rem;
  }

  .metric-card {
    padding: 0.75rem;
  }
}
